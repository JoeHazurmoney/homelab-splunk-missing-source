# Managed by the homelab_splunk role (probe tag); local edits are overwritten.
# The UF monitors only probe.log, by path, so a rotated copy is never read again (task 8 R7).
{{ hl_probe_dir }}/probe.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0644 root root
}
