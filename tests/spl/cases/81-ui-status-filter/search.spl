| `dh_ui_status(@status@)` | eval c="all"
| append [| `dh_ui_status(@status@)` | eval f_site="lab", f_owner="*", f_index="*", f_crit="*", f_status="*", f_text="*" | `dh_ui_filter` | eval c="site"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="sec", f_index="*", f_crit="*", f_status="*", f_text="*" | `dh_ui_filter` | eval c="owner"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="linux", f_crit="*", f_status="*", f_text="*" | `dh_ui_filter` | eval c="index"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="1", f_status="*", f_text="*" | `dh_ui_filter` | eval c="crit"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="*", f_status="DOWN", f_text="*" | `dh_ui_filter` | eval c="rollup"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="*", f_status="LATE", f_text="*" | `dh_ui_filter` | eval c="status"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="*", f_status="*", f_text="SECURITY*" | `dh_ui_filter` | eval c="text"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="*", f_status="*", f_text="a1|syslog" | `dh_ui_filter` | eval c="text_id"]
| append [| `dh_ui_status(@status@)` | eval f_site="*", f_owner="*", f_index="*", f_crit="*", f_status="*", f_text="stream, \"stopped\"" | `dh_ui_filter` | eval c="quotes"]
| append [| `dh_ui_status(@status@)` | eval f_site="lab", f_owner="ops", f_index="linux", f_crit="2", f_status="LATE", f_text="stream" | `dh_ui_filter` | eval c="combined"]
