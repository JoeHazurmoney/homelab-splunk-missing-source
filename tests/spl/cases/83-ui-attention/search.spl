| inputlookup @status@ | `dh_ui_attention(@NOW@)` | streamstats count as pos | eval c="main"
| append [| inputlookup @ok@ | `dh_ui_attention(@NOW@)` | eval c="ok", pos=0]
| append [| inputlookup @gate@ | `dh_ui_attention(@NOW@)` | eval c="gate", pos=0]
| append [| inputlookup @ok@ | where 1==0 | `dh_ui_attention(@NOW@)` | eval c="none", pos=0]
